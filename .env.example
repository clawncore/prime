# CLAWN PRIME Configuration
# Copy this to .env and fill in your API keys

# Gemini LLM API Key
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini Model (must be available for your API key)
GEMINI_MODEL=gemini-3.6-flash

# TTS Provider (options: sapi, flutter_tts)
TTS_PROVIDER=sapi

# Windows SAPI Voice Settings
SAPI_VOICE=Microsoft Zira Desktop
SAPI_RATE=1.0
SAPI_VOLUME=1.0

# Backend Server (optional - for multi-agent features)
# OPENROUTER_API_KEY=
# SERVER_URL=http://localhost:4000
